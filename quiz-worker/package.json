{
  "name": "quiz-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "db:migrate:local": "wrangler d1 migrations apply quiz-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply quiz-db --remote",
    "db:seed:local": "wrangler d1 execute quiz-db --local --file=seeds/rabbitmq-fundamentos.sql",
    "db:seed:remote": "wrangler d1 execute quiz-db --remote --file=seeds/rabbitmq-fundamentos.sql"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
